__d(function(e,o,l,i,r,n,a){r.exports=[{id:"munsell_70",munsell_color_id:70,colorName:"Dark Red Black",munsellCode:"10R 2.5/1",full_code:"10R 2.5/1",hue:"10R",value:"2.5",chroma:"1",hexCode:"#503030",description:"This very dark, low-value color indicates very high soil organic carbon (>8%), typical of highly organic, moist, or forest-influenced surface soils where organic matter strongly masks mineral color.",soil_organic_index:"Very High (>8%)",soil_type:"Highly organic, wet/forest soil"},{id:"munsell_71",munsell_color_id:71,colorName:"Dark Red",munsellCode:"10R 2.5/2",full_code:"10R 2.5/2",hue:"10R",value:"2.5",chroma:"2",hexCode:"#3e2018",description:"The dark red hue with very high organic content suggests a humic, iron-rich surface layer formed from red-derived parent material under organic accumulation.",soil_organic_index:"Very High (>8%)",soil_type:"Humic, red derived"},{id:"munsell_65",munsell_color_id:65,colorName:"Reddish Black",munsellCode:"10R 3/1",full_code:"10R 3/1",hue:"10R",value:"3",chroma:"1",hexCode:"#6a4a44",description:"A nearly black red color reflecting very high organic matter concentration, characteristic of organic-rich red soils in wet or shaded environments.",soil_organic_index:"Very High (>8%)",soil_type:"Organic-rich red soil"},{id:"munsell_66",munsell_color_id:66,colorName:"Dark Reddish Brown",munsellCode:"10R 3/2",full_code:"10R 3/2",hue:"10R",value:"3",chroma:"2",hexCode:"#5e3028",description:"Dark reddish-brown coloring points to high organic carbon (6\u20138%), representing a humic red surface horizon where organic and iron oxides combine.",soil_organic_index:"High (6\u20138%)",soil_type:"Humic red soil"},{id:"munsell_67",munsell_color_id:67,colorName:"Reddish Brown",munsellCode:"10R 3/3",full_code:"10R 3/3",hue:"10R",value:"3",chroma:"3",hexCode:"#602820",description:"Moderate to high organic content (4\u20136%) creates reddish-brown hues common in iron-rich red soils with substantial organic influence.",soil_organic_index:"Moderate\u2013High (4\u20136%)",soil_type:"Iron-rich red soil"},{id:"munsell_68",munsell_color_id:68,colorName:"Reddish Brown",munsellCode:"10R 3/4",full_code:"10R 3/4",hue:"10R",value:"3",chroma:"4",hexCode:"#5c2018",description:"This reddish-brown tone indicates moderate organic levels (3\u20134%), typical of ferric mineral red soils with modest organic input.",soil_organic_index:"Moderate (3\u20134%)",soil_type:"Ferric/red soil"},{id:"munsell_69",munsell_color_id:69,colorName:"Red",munsellCode:"10R 3/6",full_code:"10R 3/6",hue:"10R",value:"3",chroma:"6",hexCode:"#501812",description:"Brighter red with low to moderate organic content (2\u20133%) signals an oxidized red mineral horizon where iron oxides are clearly expressed.",soil_organic_index:"Low\u2013Moderate (2\u20133%)",soil_type:"Oxidized red soil"},{id:"munsell_59",munsell_color_id:59,colorName:"Red Gray",munsellCode:"10R 4/1",full_code:"10R 4/1",hue:"10R",value:"4",chroma:"1",hexCode:"#8c6860",description:"Grayish-red coloring with high organic content (6\u20138%) suggests a moist, humic-influenced red soil where reduction or organic coating grays the matrix.",soil_organic_index:"High (6\u20138%)",soil_type:"Humic red, moist"},{id:"munsell_60",munsell_color_id:60,colorName:"Dark Red",munsellCode:"10R 4/2",full_code:"10R 4/2",hue:"10R",value:"4",chroma:"2",hexCode:"#804a38",description:"Dark red with moderate to high organic content reflects a red mineral surface coated or mixed with appreciable organic matter.",soil_organic_index:"Moderate\u2013High (4\u20136%)",soil_type:"Red soil with organic coating"},{id:"munsell_61",munsell_color_id:61,colorName:"Red Brown",munsellCode:"10R 4/3",full_code:"10R 4/3",hue:"10R",value:"4",chroma:"3",hexCode:"#823830",description:"Red-brown tones with moderate organic levels indicate a transitional red-yellow soil influenced by both iron and organic materials.",soil_organic_index:"Moderate (3\u20134%)",soil_type:"Red-yellow soil"},{id:"munsell_62",munsell_color_id:62,colorName:"Red Brown",munsellCode:"10R 4/4",full_code:"10R 4/4",hue:"10R",value:"4",chroma:"4",hexCode:"#7e3028",description:"Red-brown coloring with moderate organic content represents a ferric loam where iron oxides and organic particles are balanced.",soil_organic_index:"Moderate (3\u20134%)",soil_type:"Ferric loam"},{id:"munsell_63",munsell_color_id:63,colorName:"Red",munsellCode:"10R 4/6",full_code:"10R 4/6",hue:"10R",value:"4",chroma:"6",hexCode:"#782820",description:"Distinct red with low to moderate organic content resembles the highly weathered mineral horizon of Oxisols or Ultisols dominated by iron oxides.",soil_organic_index:"Low\u2013Moderate (2\u20133%)",soil_type:"Oxisol/Ultisol-like"},{id:"munsell_64",munsell_color_id:64,colorName:"Bright Red",munsellCode:"10R 4/8",full_code:"10R 4/8",hue:"10R",value:"4",chroma:"8",hexCode:"#6e2018",description:"Intense bright red with very low organic carbon (<1%) indicates a highly leached, iron-enriched mineral subsoil with negligible organic matter.",soil_organic_index:"Very Low (<1%)",soil_type:"Highly leached, iron-rich"},{id:"munsell_53",munsell_color_id:53,colorName:"Pinkish Gray",munsellCode:"10R 5/1",full_code:"10R 5/1",hue:"10R",value:"5",chroma:"1",hexCode:"#a88880",description:"Pale grayish-red with moderate to high organic content suggests a weathered red subsoil with organic influence in lighter material.",soil_organic_index:"Moderate\u2013High (4\u20136%)",soil_type:"Weathered red with organic subsoil"},{id:"munsell_54",munsell_color_id:54,colorName:"Pale Red",munsellCode:"10R 5/2",full_code:"10R 5/2",hue:"10R",value:"5",chroma:"2",hexCode:"#9c6858",description:"Faded pale red with moderate organic levels represents weakly developed red soils where weathering has softened the hue.",soil_organic_index:"Moderate (3\u20134%)",soil_type:"Weakly developed red soil"},{id:"munsell_55",munsell_color_id:55,colorName:"Reddish Yellow",munsellCode:"10R 5/3",full_code:"10R 5/3",hue:"10R",value:"5",chroma:"3",hexCode:"#9e5848",description:"Reddish-yellow coloring with low to moderate organic content marks the transition zone between red and yellow soil profiles.",soil_organic_index:"Low\u2013Moderate (2\u20133%)",soil_type:"Red-yellow intergrade"},{id:"munsell_56",munsell_color_id:56,colorName:"Reddish Yellow",munsellCode:"10R 5/4",full_code:"10R 5/4",hue:"10R",value:"5",chroma:"4",hexCode:"#9a5040",description:"Reddish-yellow tones indicate low to moderate organic levels in red-yellow intergrade soils common in tropical weathering regimes.",soil_organic_index:"Low\u2013Moderate (2\u20133%)",soil_type:"Red-yellow soil"},{id:"munsell_57",munsell_color_id:57,colorName:"Red",munsellCode:"10R 5/6",full_code:"10R 5/6",hue:"10R",value:"5",chroma:"6",hexCode:"#923830",description:"Clear red with low organic content (1\u20132%) reflects a strongly oxidized mineral horizon dominated by iron oxides.",soil_organic_index:"Low (1\u20132%)",soil_type:"Strongly oxidized"},{id:"munsell_58",munsell_color_id:58,colorName:"Bright Red",munsellCode:"10R 5/8",full_code:"10R 5/8",hue:"10R",value:"5",chroma:"8",hexCode:"#8e3020",description:"Vivid red with very low organic content denotes a highly leached, dry mineral environment with intense iron expression.",soil_organic_index:"Very Low (<1%)",soil_type:"Highly leached, dry"},{id:"munsell_47",munsell_color_id:47,colorName:"Grayish Pink",munsellCode:"10R 6/1",full_code:"10R 6/1",hue:"10R",value:"6",chroma:"1",hexCode:"#bf9e98",description:"Pale grayish-red with moderate organic levels indicates partially leached, weathered red material in lighter horizons.",soil_organic_index:"Moderate (3\u20134%)",soil_type:"Weathered, partially leached"},{id:"munsell_48",munsell_color_id:48,colorName:"Pale Red",munsellCode:"10R 6/2",full_code:"10R 6/2",hue:"10R",value:"6",chroma:"2",hexCode:"#b88878",description:"Lightened pale red with low to moderate organic content signals a weakly humic red subsoil horizon.",soil_organic_index:"Low\u2013Moderate (2\u20133%)",soil_type:"Weakly humic red subsoil"},{id:"munsell_49",munsell_color_id:49,colorName:"Light Reddish Brown",munsellCode:"10R 6/3",full_code:"10R 6/3",hue:"10R",value:"6",chroma:"3",hexCode:"#bc7a68",description:"Pale reddish-brown with low organic content characterizes mineral subsoil with little organic accumulation.",soil_organic_index:"Low (1\u20132%)",soil_type:"Subsoil, low organic"},{id:"munsell_50",munsell_color_id:50,colorName:"Light Reddish Brown",munsellCode:"10R 6/4",full_code:"10R 6/4",hue:"10R",value:"6",chroma:"4",hexCode:"#b87060",description:"Pale reddish-brown tones with low organic levels represent a B-horizon in red soils where organic influence is minimal.",soil_organic_index:"Low (1\u20132%)",soil_type:"B-horizon red soil"},{id:"munsell_51",munsell_color_id:51,colorName:"Yellowish Red",munsellCode:"10R 6/6",full_code:"10R 6/6",hue:"10R",value:"6",chroma:"6",hexCode:"#b04840",description:"Yellowish-red with very low organic carbon indicates a well-drained, thoroughly leached mineral horizon.",soil_organic_index:"Very Low (<1%)",soil_type:"Leached, well drained"},{id:"munsell_52",munsell_color_id:52,colorName:"Red",munsellCode:"10R 6/8",full_code:"10R 6/8",hue:"10R",value:"6",chroma:"8",hexCode:"#ac4030",description:"Bright red with very low organic content reflects exposed, dry, iron-rich mineral surfaces with no organic accumulation.",soil_organic_index:"Very Low (<1%)",soil_type:"Exposed, dry, iron-rich"},{id:"munsell_41",munsell_color_id:41,colorName:"Pinkish White",munsellCode:"10R 7/1",full_code:"10R 7/1",hue:"10R",value:"7",chroma:"1",hexCode:"#d8b8b2",description:"Near-white with pink hints and moderate organic levels suggests highly weathered, light-colored material with residual organic influence.",soil_organic_index:"Moderate (3\u20134%)",soil_type:"Highly weathered, light-colored"},{id:"munsell_42",munsell_color_id:42,colorName:"Pale Pink",munsellCode:"10R 7/2",full_code:"10R 7/2",hue:"10R",value:"7",chroma:"2",hexCode:"#d4a89e",description:"Fai